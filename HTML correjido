    <!-- Vanilla JavaScript aislado (IIFE) con manipulación del DOM mediante textContent -->
    <script>
      (function () {
        "use strict";

        // Defensa activa del DOM: bloquea y purga nodos inyectados externamente en <main> (ej. main.prepend(section))
        var contenedorMain = document.querySelector(".pos-main");
        var seccionesLegitimas = ["inicio", "libros"];

        function esNodoAutorizado(nodo) {
          if (nodo.nodeType !== 1) return true;
          var id = nodo.getAttribute("id") || "";
          var tieneClasePos =
            nodo.classList &&
            (nodo.classList.contains("pos-hero") ||
              nodo.classList.contains("pos-catalog"));
          return tieneClasePos && seccionesLegitimas.indexOf(id) !== -1;
        }

        if (contenedorMain) {
          Array.prototype.slice
            .call(contenedorMain.children)
            .forEach(function (hijo) {
              if (!esNodoAutorizado(hijo)) {
                contenedorMain.removeChild(hijo);
              }
            });

          var observadorIntegridad = new MutationObserver(function (mutaciones) {
            mutaciones.forEach(function (mutacion) {
              Array.prototype.slice
                .call(mutacion.addedNodes)
                .forEach(function (nodoAgregado) {
                  if (
                    nodoAgregado.nodeType === 1 &&
                    !esNodoAutorizado(nodoAgregado) &&
                    nodoAgregado.parentNode === contenedorMain
                  ) {
                    contenedorMain.removeChild(nodoAgregado);
                  }
                });
            });
          });

          observadorIntegridad.observe(contenedorMain, { childList: true });
        }

        var anioActual = new Date().getFullYear();

        // 1. Reemplazo de document.write() por manipulación del DOM con textContent
        var bannerPromocion = document.getElementById("banner-promocion");
        var footerDerechos = document.getElementById("footer-derechos");
        var footerPromocion = document.getElementById("footer-promocion");

        if (bannerPromocion) {
          bannerPromocion.textContent =
            "Promoción Especial Campus UPTC " +
            anioActual +
            ": 20% de descuento presentando carnet estudiantil o docente activo en compras de ediciones académicas.";
        }

        if (footerDerechos) {
          footerDerechos.textContent =
            "© " +
            anioActual +
            " POS Campus Sales UPTC — Todos los derechos reservados.";
        }

        if (footerPromocion) {
          footerPromocion.textContent =
            "Promoción vigente " +
            anioActual +
            ": Envío digital inmediato sin recargo y 20% dto. con carnet UPTC.";
        }

        // Estado e interactividad de Pestañas (Tabs) y Carrito POS
        var formatoActual = "impreso";
        var carrito = [];

        var botonesTab = document.querySelectorAll(".pos-tab");
        var estadoPestana = document.getElementById("estado-pestana");
        var articulosLibros = document.querySelectorAll(".pos-book-card");
        var contadorCarrito = document.getElementById("contador-carrito");
        var btnVerCarrito = document.getElementById("btn-ver-carrito");
        var modalPos = document.getElementById("modal-pos");
        var tablaCarrito = document.getElementById("tabla-carrito");
        var totalCarrito = document.getElementById("total-carrito");
        var btnCerrarModal = document.getElementById("btn-cerrar-modal");
        var btnVaciar = document.getElementById("btn-vaciar");

        function formatearMoneda(valor) {
          var numero = parseInt(valor, 10) || 0;
          return "$" + numero.toLocaleString("es-CO") + " COP";
        }

        function cambiarPestanaFormato(nuevoFormato) {
          formatoActual = nuevoFormato;

          botonesTab.forEach(function (boton) {
            var esActivo = boton.getAttribute("data-formato") === nuevoFormato;
            boton.setAttribute("aria-selected", esActivo ? "true" : "false");
          });

          if (nuevoFormato === "impreso") {
            estadoPestana.textContent =
              "Mostrando tarifas de Edición Impresa (Empastado rústico editorial · Retiro inmediato en caja POS UPTC).";
          } else {
            estadoPestana.textContent =
              "Mostrando tarifas de Edición Digital (eBook PDF/ePub) (Acceso inmediato con correo institucional @uptc.edu.co).";
          }

          articulosLibros.forEach(function (articulo) {
            var precio =
              nuevoFormato === "impreso"
                ? articulo.getAttribute("data-precio-impreso")
                : articulo.getAttribute("data-precio-digital");

            var elementoData = articulo.querySelector(".pos-book-price");
            var spanPrecio = articulo.querySelector(".pos-book-amount");
            var etiquetaFormato = articulo.querySelector(".pos-book-format");

            elementoData.setAttribute("value", precio);
            spanPrecio.textContent = formatearMoneda(precio);
            etiquetaFormato.textContent =
              nuevoFormato === "impreso"
                ? "Edición Impresa"
                : "Licencia Digital";
          });
        }

        function actualizarVistaCarrito() {
          contadorCarrito.textContent = String(carrito.length);
          tablaCarrito.textContent = "";

          if (carrito.length === 0) {
            var filaVacia = document.createElement("tr");
            var celdaVacia = document.createElement("td");
            celdaVacia.setAttribute("colspan", "2");
            celdaVacia.className = "pos-modal-td";
            celdaVacia.textContent = "Aún no has agregado libros al carrito.";
            filaVacia.appendChild(celdaVacia);
            tablaCarrito.appendChild(filaVacia);
            totalCarrito.textContent = "$0 COP";
            return;
          }

          var sumaTotal = 0;

          carrito.forEach(function (item) {
            sumaTotal += item.precio;

            var fila = document.createElement("tr");

            var celdaTitulo = document.createElement("td");
            celdaTitulo.className = "pos-modal-td";
            celdaTitulo.textContent = item.titulo + " (" + item.modalidad + ")";

            var celdaPrecio = document.createElement("td");
            celdaPrecio.className = "pos-modal-td pos-modal-td-right";
            celdaPrecio.textContent = formatearMoneda(item.precio);

            fila.appendChild(celdaTitulo);
            fila.appendChild(celdaPrecio);
            tablaCarrito.appendChild(fila);
          });

          totalCarrito.textContent = formatearMoneda(sumaTotal);
        }

        botonesTab.forEach(function (boton) {
          boton.addEventListener("click", function () {
            var formatoSeleccionado = boton.getAttribute("data-formato");
            cambiarPestanaFormato(formatoSeleccionado);
          });
        });

        articulosLibros.forEach(function (articulo) {
          var botonAgregar = articulo.querySelector(".pos-add-btn");
          botonAgregar.addEventListener("click", function () {
            var titulo = articulo.getAttribute("data-titulo");
            var precioActual =
              formatoActual === "impreso"
                ? parseInt(articulo.getAttribute("data-precio-impreso"), 10)
                : parseInt(articulo.getAttribute("data-precio-digital"), 10);
            var modalidadTexto =
              formatoActual === "impreso" ? "Impreso" : "Digital";

            carrito.push({
              titulo: titulo,
              precio: precioActual,
              modalidad: modalidadTexto,
            });

            actualizarVistaCarrito();

            var textoOriginal = "Agregar al carrito";
            botonAgregar.textContent = "Agregado ✓";
            setTimeout(function () {
              botonAgregar.textContent = textoOriginal;
            }, 900);
          });
        });

        btnVerCarrito.addEventListener("click", function () {
          actualizarVistaCarrito();
          if (typeof modalPos.showModal === "function") {
            modalPos.showModal();
          }
        });

        btnCerrarModal.addEventListener("click", function () {
          modalPos.close();
        });

        btnVaciar.addEventListener("click", function () {
          carrito = [];
          actualizarVistaCarrito();
        });
      })();
    </script>
  </body>
</html>


