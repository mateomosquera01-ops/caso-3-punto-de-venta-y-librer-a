// archivo generado de manera inicial del propio HTML


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>POS Campus Sales - Librería UPTC</title>
    <style>
        /* 
         * REGLAS CSS GLOBALES SOBRE ETIQUETAS (SIN CLASES)
         */

        /* Reset y base */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            color: #333;
        }
        
        /* Banner superior para el document.write */
        aside {
            background-color: #d9534f;
            color: white;
            text-align: center;
            padding: 12px;
            font-weight: bold;
            font-size: 14px;
            letter-spacing: 0.5px;
        }

        /* Encabezado y Navegación */
        header {
            background-color: #2c3e50;
            color: #f1c40f;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 50px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        
        header h1 {
            margin: 0;
            font-size: 24px;
            text-transform: uppercase;
        }
        
        nav ul {
            list-style-type: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 25px;
        }
        
        nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            font-size: 15px;
            transition: color 0.3s;
        }
        
        nav a:hover {
            color: #f1c40f;
        }

        /* Contenedor Principal */
        main {
            padding: 40px 50px;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Hero Section (Se selecciona la primera sección del main) */
        main > section:nth-of-type(1) {
            background-color: #ecf0f1;
            text-align: center;
            padding: 80px 20px;
            border-radius: 12px;
            margin-bottom: 50px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            border-top: 5px solid #f1c40f;
        }

        main > section:nth-of-type(1) h2 {
            font-size: 38px;
            color: #2c3e50;
            margin-top: 0;
        }

        main > section:nth-of-type(1) p {
            font-size: 18px;
            color: #555;
            max-width: 650px;
            margin: 0 auto 30px auto;
            line-height: 1.6;
        }

        main > section:nth-of-type(1) button {
            background-color: #27ae60;
            color: white;
            border: none;
            padding: 15px 35px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        main > section:nth-of-type(1) button:hover {
            background-color: #2ecc71;
        }

        /* Menú de Pestañas (Tabs) */
        menu {
            display: flex;
            justify-content: center;
            gap: 20px;
            padding: 0;
            margin: 0 0 40px 0;
        }

        menu button {
            background-color: transparent;
            border: 2px solid #3498db;
            color: #3498db;
            padding: 12px 40px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s;
        }

        /* Estado activo del Tab (usando el atributo disabled en lugar de clases) */
        menu button[disabled] {
            background-color: #3498db;
            color: white;
            cursor: default;
            box-shadow: 0 4px 6px rgba(52, 152, 219, 0.3);
        }

        /* Sección de Libros Destacados */
        main > section:nth-of-type(2) {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
        }

        /* Tarjetas de Libros */
        article {
            background: white;
            width: 320px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease;
        }

        article:hover {
            transform: translateY(-8px);
        }

        article img {
            width: 100%;
            height: 240px;
            object-fit: cover;
            border-bottom: 3px solid #ecf0f1;
        }

        /* Contenido interno de la tarjeta */
        article > div {
            padding: 25px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        article h3 {
            margin: 0 0 10px 0;
            color: #2c3e50;
            font-size: 20px;
            line-height: 1.3;
        }

        article em {
            color: #7f8c8d;
            font-style: normal;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 15px;
        }

        article p {
            color: #666;
            font-size: 14.5px;
            line-height: 1.5;
            margin-bottom: 20px;
            flex-grow: 1;
        }

        article b {
            font-size: 26px;
            color: #e74c3c;
            margin-bottom: 20px;
            text-align: center;
            display: block;
        }

        article button {
            background-color: #f39c12;
            color: white;
            border: none;
            padding: 14px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        article button:hover {
            background-color: #e67e22;
        }

        /* Pie de página (Footer) */
        footer {
            background-color: #2c3e50;
            color: #bdc3c7;
            text-align: center;
            padding: 40px 20px;
            margin-top: 60px;
            border-top: 5px solid #34495e;
        }

        footer h3 {
            color: white;
            margin-top: 0;
            margin-bottom: 15px;
        }

        footer p {
            margin: 8px 0;
            font-size: 15px;
        }
    </style>
</head>
<body>

    <!-- 5. Uso de document.write para promoción y año actual -->
    <aside>
        <script>
            document.write("¡Promoción especial de semestre! Año " + new Date().getFullYear() + " - Obtén un 20% de descuento comprando en nuestro punto de venta en el campus.");
        </script>
    </aside>

    <!-- 1. Encabezado con título y menú de navegación -->
    <header id="inicio">
        <h1>POS Campus Sales</h1>
        <nav>
            <ul>
                <li><a href="#inicio">Inicio</a></li>
                <li><a href="#libros">Libros</a></li>
                <li><a href="#contactos">Contactos</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <!-- 2. Hero Section -->
        <section>
            <h2>Tu librería universitaria en la UPTC</h2>
            <p>Encuentra todos los textos académicos, guías de estudio y literatura que necesitas para tu camino al éxito profesional. Adquiere tus recursos fácilmente en nuestro Punto de Venta del campus.</p>
            <button>Ver catálogo completo</button>
        </section>

        <!-- 6. Pestañas interactivas (Tabs) para alternar precios -->
        <menu>
            <!-- El atributo disabled se usa visualmente como la pestaña activa -->
            <button disabled>Libros Impresos</button>
            <button>Ediciones Digitales</button>
        </menu>

        <!-- 3. Sección de libros destacados (3 tarjetas) -->
        <section id="libros">
            <article>
                <img src="https://via.placeholder.com/320x240/2c3e50/ffffff?text=Calculo+Integral" alt="Portada de Libro de Cálculo">
                <div>
                    <h3>Cálculo Integral para Ingenieros</h3>
                    <em>Autor: Prof. Carlos Ramírez</em>
                    <p>Un enfoque práctico y directo para entender el cálculo integral, adaptado al currículo de ingeniería de la UPTC.</p>
                    <b>$ 45.000 COP</b>
                    <button>Agregar al carrito</button>
                </div>
            </article>

            <article>
                <img src="https://via.placeholder.com/320x240/8e44ad/ffffff?text=Historia+de+Colombia" alt="Portada de Libro de Historia">
                <div>
                    <h3>Historia de Colombia Contemporánea</h3>
                    <em>Autor: Dra. María Fernanda</em>
                    <p>Análisis detallado de los sucesos políticos, sociales y económicos del siglo XX en el territorio nacional.</p>
                    <b>$ 60.000 COP</b>
                    <button>Agregar al carrito</button>
                </div>
            </article>

            <article>
                <img src="https://via.placeholder.com/320x240/16a085/ffffff?text=Programacion+Java" alt="Portada de Libro de Programación">
                <div>
                    <h3>Fundamentos de Programación</h3>
                    <em>Autor: Ing. Luis Torres</em>
                    <p>Aprende lógica y diseño de algoritmos desde cero con ejemplos claros en lenguajes modernos como Python y Java.</p>
                    <b>$ 35.000 COP</b>
                    <button>Agregar al carrito</button>
                </div>
            </article>
        </section>
    </main>

    <!-- 4. Footer con datos de contacto -->
    <footer id="contactos">
        <h3>Librería POS Campus Sales - UPTC</h3>
        <p><strong>Dirección:</strong> Sede Central UPTC, Edificio Administrativo (Primer piso), Tunja, Boyacá.</p>
        <p><strong>Teléfono:</strong> +57 (8) 740 5626 Ext. 1234</p>
        <p><strong>Email:</strong> pos.libreria@uptc.edu.co</p>
    </footer>

    <!-- 6. Lógica de Pestañas en Vanilla JavaScript (Aislado) -->
    <script>
        (function() {
            // Arrays con los precios según formato (sin necesidad de recargar la página)
            const preciosImpresos = ['$ 45.000 COP', '$ 60.000 COP', '$ 35.000 COP'];
            const preciosDigitales = ['$ 22.500 COP', '$ 30.000 COP', '$ 17.500 COP'];

            // Se seleccionan los elementos de las pestañas basándose estrictamente en las etiquetas
            const botonesTabs = document.querySelectorAll('menu button');
            const etiquetasPrecios = document.querySelectorAll('article b');

            // Lógica para la pestaña de Libros Impresos
            botonesTabs[0].addEventListener('click', function() {
                // Alternar estado visual
                botonesTabs[0].disabled = true;
                botonesTabs[1].disabled = false;
                
                // Actualizar los precios en cada tarjeta
                etiquetasPrecios.forEach(function(etiqueta, indice) {
                    etiqueta.textContent = preciosImpresos[indice];
                });
            });

            // Lógica para la pestaña de Ediciones Digitales
            botonesTabs[1].addEventListener('click', function() {
                // Alternar estado visual
                botonesTabs[1].disabled = true;
                botonesTabs[0].disabled = false;
                
                // Actualizar los precios en cada tarjeta
                etiquetasPrecios.forEach(function(etiqueta, indice) {
                    etiqueta.textContent = preciosDigitales[indice];
                });
            });
        })();
    </script>
</body>
</html>
